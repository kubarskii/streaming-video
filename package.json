{
  "name": "video",
  "version": "1.0.0",
  "description": "Video streaming service with DDD architecture",
  "main": "server.js",
  "scripts": {
    "start": "concurrently \"node services/gateway/server.js\" \"node services/upload/server.js\" \"node services/streaming/server.js\" \"node worker.js\"",
    "start:monolith": "concurrently \"node server.js\" \"node worker.js\"",
    "start:no-gateway": "concurrently \"node services/upload/server.js\" \"node services/streaming/server.js\" \"node worker.js\"",
    "dev": "nodemon server.js",
    "worker": "node worker.js",
    "worker:dev": "nodemon worker.js",
    "service:gateway": "node services/gateway/server.js",
    "service:upload": "node services/upload/server.js",
    "service:streaming": "node services/streaming/server.js",
    "service:processing": "node worker.js",
    "dev:upload": "nodemon services/upload/server.js",
    "dev:streaming": "nodemon services/streaming/server.js",
    "build": "cd frontend && npm install && npm run build && cd ..",
    "build:frontend": "cd frontend && npm run build",
    "postinstall": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "migrate:export": "node scripts/migrate-sqlite-to-postgres.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "setup": "npm install && npm run db:generate && npm run migrate",
    "queue:mov-convert": "node scripts/queue-mov-conversions.js",
    "queue:check": "node scripts/check-jobs.js",
    "queue:retry": "node scripts/retry-failed-jobs.js",
    "queue:retry:all": "node scripts/retry-failed-jobs.js all",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@prisma/client": "^5.20.0",
    "argon2": "^0.31.2",
    "bullmq": "^5.34.4",
    "concurrently": "^9.2.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "fluent-ffmpeg": "^2.1.3",
    "formidable": "^3.5.1",
    "http-proxy-middleware": "^3.0.5",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "uuid": "^9.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.9.2",
    "eslint": "^9.38.0",
    "nodemon": "^3.1.9",
    "prisma": "^5.20.0",
    "typescript": "^5.9.3"
  }
}